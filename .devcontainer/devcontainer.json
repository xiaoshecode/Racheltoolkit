{
  "name": "Racheltoolkit online trial",
  "image": "mcr.microsoft.com/devcontainers/python:3.13-bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": {"cpus": 2, "memory": "8gb"},
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "Racheltoolkit teaching trial", "onAutoForward": "notify", "protocol": "http"}
  },
  "postCreateCommand": "python3 scripts/codespaces.py setup",
  "postStartCommand": "python3 scripts/codespaces.py start",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {"settings": {"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv-codespaces/bin/python"}}
  }
}
