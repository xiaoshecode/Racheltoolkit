# Copy to deploy/.env with mode 0600. Keep real values out of Git and logs.
COMPOSE_FILE=compose.local.yml
COMPOSE_PROJECT_NAME=racheltoolkit
TEACH_RELEASE=replace-with-verified-git-sha
# One DNS hostname or stable public IPv4 address; no https://, port, or path.
TEACH_HOST=
# DNS hostname: ./Caddyfile (default). Public IPv4: ./Caddyfile.ip.
TEACH_CADDY_FILE=./Caddyfile
TEACH_PORTAL_ORIGIN=https://xiaoshecode.github.io
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.production_local
TEACH_STORAGE_BACKEND=local
TEACH_PERSIST_DIR=/srv/teaching-data
TEACH_DATA_DIR=/data
TEACH_DB=/data/school.sqlite3
# Choose an existing private backup location; also keep an off-host copy.
TEACH_BACKUP_DIR=/srv/teaching-backups
