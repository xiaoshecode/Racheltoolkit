# Optional public-IP mode: set TEACH_CADDY_FILE=./Caddyfile.ip in deploy/.env.
# For DNS hostnames, use the default ./Caddyfile and automatic HTTPS.
{
    # Browsers normally omit SNI when connecting to an IP address. In a
    # container behind NAT, select the public IP certificate explicitly.
    default_sni {$TEACH_HOST}
}

{$TEACH_HOST} {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
        }
    }

    encode gzip
    @courses path /teacher/courses/*
    request_body @courses {
        max_size 105MB
    }
    @ordinary not path /teacher/courses/*
    request_body @ordinary {
        max_size 22MB
    }
    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }
    handle {
        reverse_proxy web:8000
    }
}
