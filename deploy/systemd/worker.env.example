# Installed as /etc/racheltoolkit/worker.env (root:root, mode 0600).
# systemd reads the main teaching .env first, then these host-side overrides.
DJANGO_SETTINGS_MODULE=config.production
TEACH_DATA_DIR=/srv/teaching-data
TEACH_DB=/srv/teaching-data/school.sqlite3
DOCKER_HOST=unix:///run/user/10001/docker.sock
XDG_RUNTIME_DIR=/run/user/10001
# Build into the teacher user's ROOTLESS daemon and replace with its exact ID.
TEACH_OFFICE_IMAGE=sha256:replace-with-the-verified-image-id

