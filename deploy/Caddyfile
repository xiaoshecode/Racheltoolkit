{$TEACH_HOST} {
    encode gzip
    @courses path /teacher/courses/*
    request_body @courses {
        max_size 105MB
    }
    @ordinary not path /teacher/courses/*
    request_body @ordinary {
        max_size 22MB
    }
    handle_path /static/* {
        root * /srv/staticfiles
        file_server
    }
    handle {
        reverse_proxy web:8000
    }
}

